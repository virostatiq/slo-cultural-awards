---
import { url } from "../lib/url";
import Base from "../layouts/Base.astro";
import { people, awards, meta, personUrl, awardUrl, fmt } from "../lib/data";
import { years } from "../lib/years";
const c = meta.counts;
const top = Object.values(awards).filter((a) => a.prestige === 5).sort((a, b) => a.name.localeCompare(b.name, "sl"));
const ppl = Object.values(people).filter((p) => p.kind === "person");
const mostWins = [...ppl].sort((a, b) => b.wins.length - a.wins.length).slice(0, 8);
const mostJury = [...ppl].sort((a, b) => b.juries.length - a.juries.length).slice(0, 8);
const last = years[years.length - 1];
// Namesakes of awards in the data; portraits from Wikimedia Commons (public domain),
// cropped and toned to the site palette (docs/img has the originals).
const faces = [
  { name: "Primož Trubar", img: "trubar", award: "trubarjevo-priznanje" },
  { name: "Ivan Cankar", img: "cankar", award: "cankarjeva-nagrada" },
  { name: "Josip Jurčič", img: "jurcic", award: "jurciceva-nagrada" },
  { name: "Josip Stritar", img: "stritar", award: "stritarjeva-nagrada" },
];
const dot = (f: string) => `background:${meta.fields[f] ?? "var(--muted)"}`;
---
<Base title="Kulturne nagrade" description={`Zbirka slovenskih kulturnih nagrad ${c.years[0]}–${c.years[1]}: ${fmt(c.awards)} nagrad, ${fmt(c.people)} nagrajencev in žirantov, z žirijami in zemljevidom povezav.`}>
  <section class="hero" slot="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>Kdo podeljuje slovenske kulturne nagrade in kdo jih prejema?</h1>
        <p class="lede">Zbirka {fmt(c.awards)} nagrad od leta {c.years[0]} do {c.years[1]}: {fmt(c.wins)} nagrad
          za {fmt(c.people)} ljudi in skupin, z žirijami, ki so jih podelile.</p>
        <form action={url("/seznam/")} method="get" class="hero-search" role="search">
          <label class="sr" for="hq">Iskanje</label>
          <input id="hq" name="q" type="search" placeholder="Ime osebe ali nagrade" />
          <button class="btn solid" type="submit">Išči</button>
        </form>
      </div>
      <figure class="faces">
        {faces.map((f) => (
          <a href={awardUrl(f.award)} class="face">
            <img src={url(`/img/obrazi/${f.img}.webp`)} alt={`${f.name}, portret`} width="480" height="600"
              loading="eager" decoding="async" />
            <span><b>{f.name}</b>{awards[f.award]?.name ?? ""}</span>
          </a>
        ))}
        <figcaption>Po njih se imenujejo nagrade v zbirki. Portreti: Wikimedia Commons, javna domena.</figcaption>
      </figure>
    </div>
  </section>

  <div class="stats home-stats">
    <div class="stat"><b>{fmt(c.awards)}</b><span>nagrad</span></div>
    <div class="stat"><b>{fmt(c.editions)}</b><span>podelitev</span></div>
    <div class="stat"><b>{fmt(c.people)}</b><span>nagrajencev in žirantov</span></div>
    <div class="stat"><b>{fmt(c.sittings)}</b><span>sedežev v žirijah</span></div>
  </div>

  <nav class="entries" aria-label="Vstopne točke">
    <a href={url("/zemljevid/")}><b>Zemljevid</b><span>Kdo sedi v žirijah skupaj in kdo je koga izbral, po področjih.</span></a>
    <a href={url("/leta/")}><b>Po letih</b><span>Vse podelitve od {c.years[0]}. Zadnje leto: <span class="num">{last}</span>.</span></a>
    <a href={url("/seznam/")}><b>Seznam</b><span>Vsi nagrajenci, žiranti in nagrade s filtri.</span></a>
  </nav>

  <div class="cols">
    <section>
      <h2>Najvišje nagrade</h2>
      <ul class="list">{top.map((a) => <li><a href={awardUrl(a.id)}><span class="dot" style={dot(a.field)}></span>{a.name}</a><span class="n">{fmt(a.editions.length)} podelitev</span></li>)}</ul>
    </section>
    <section>
      <h2>Največ nagrad</h2>
      <ul class="list">{mostWins.map((p) => <li><a href={personUrl(p.id)}><span class="dot" style={dot(p.field)}></span>{p.name}</a><span class="n">{fmt(p.wins.length)}</span></li>)}</ul>
      <h2>Največ sedežev v žirijah</h2>
      <ul class="list">{mostJury.map((p) => <li><a href={personUrl(p.id)}><span class="dot" style={dot(p.field)}></span>{p.name}</a><span class="n">{fmt(p.juries.length)}</span></li>)}</ul>
    </section>
  </div>
  <p class="small muted" style="margin-top:28px">Zbirka ni popolna, zlasti pred letom 2000. <a href={url("/o-podatkih/")}>Kako je nastala in kaj manjka</a>.</p>

</Base>
<style>
  .hero { margin-top: -8px; padding: 24px 0 8px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .hero h1 { font-size: clamp(38px, 5.6vw, 68px); max-width: 11.5em; margin-bottom: 20px; }
  .hero .lede { margin-bottom: 22px; }
  .faces { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .face { position: relative; display: block; border-radius: 10px; overflow: hidden; text-decoration: none;
          border: 1px solid var(--line); background: var(--surface); }
  .face:nth-child(2n) { transform: translateY(28px); }
  .face img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; transition: transform .4s ease; }
  .face span { position: absolute; left: 0; right: 0; bottom: 0; padding: 28px 12px 10px; font-size: 13px; color: var(--ink-2);
               background: linear-gradient(0deg, rgba(23, 16, 34, .92), rgba(23, 16, 34, 0)); }
  .face b { display: block; font: 400 18px/1.2 var(--serif); color: var(--ink); }
  .face:hover img { transform: scale(1.03); }
  .face:hover b { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .faces figcaption { grid-column: 1 / -1; margin-top: 30px; font-size: 12.5px; color: var(--muted); }
  .hero-search { display: flex; gap: 8px; max-width: 500px; }
  .hero-search input { flex: 1; min-width: 0; font-size: 17px; padding: 11px 18px; background: rgba(31, 23, 48, .9); }
  .hero-search .btn { padding: 0 22px; font-size: 15px; }
  .hint { font-size: 14px; color: var(--ink-2); margin: 16px 0 0; max-width: 42em; }
  .hint a { color: var(--ink-2); }
  .home-stats { grid-template-columns: repeat(4, 1fr); margin: 20px 0 56px; }
  .entries { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin: 0 0 24px; }
  .entries a { text-decoration: none; border-top: 1px solid var(--line); padding-top: 14px; }
  .entries b { display: block; font: 400 26px var(--serif); margin-bottom: 4px; }
  .entries > a > span { color: var(--ink-2); font-size: 15px; }
  .entries a:hover b { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; gap: 28px; }
    .faces { grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .face:nth-child(2n) { transform: none; }
    .face span { padding: 18px 6px 6px; font-size: 0; }
    .face b { font-size: 12.5px; }
    .faces figcaption { margin-top: 4px; }
    .home-stats { grid-template-columns: 1fr 1fr; }
    .entries { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
