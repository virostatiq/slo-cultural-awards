---
import Base from "../../layouts/Base.astro";
import { byYear, years } from "../../lib/years";
import { yearUrl, fmt } from "../../lib/data";
const decades = [...new Set(years.map((y) => Math.floor(y / 10) * 10))];
const max = Math.max(...years.map((y) => byYear.get(y)!.length));
---
<Base title="Po letih" description="Vse slovenske kulturne nagrade po letih podelitve, od 1949 do danes: nagrajenci in žirije.">
  <h1>Po letih</h1>
  <p class="lede">Izberite leto podelitve. Višina stolpca pove, koliko nagrad iz tistega leta je v zbirki.
    Pred letom 2000 je zbirka redkejša.</p>
  {decades.map((d) => (
    <section>
      <h3>{d}–{d + 9}</h3>
      <div class="years">
        {years.filter((y) => y >= d && y < d + 10).map((y) => {
          const n = byYear.get(y)!.length;
          return (
            <a class="year" href={yearUrl(y)} title={`${y}: ${fmt(n)} nagrad`}>
              <span class="bar" style={`height:${8 + 40 * n / max}px`}></span>
              <span class="lbl">{y}</span>
            </a>
          );
        })}
      </div>
    </section>
  ))}
</Base>
<style>
  .years { display: flex; gap: 6px; flex-wrap: wrap; align-items: flex-end; }
  .year { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 52px;
          text-decoration: none; color: var(--ink-2); font-size: 13px; font-variant-numeric: tabular-nums; }
  .bar { width: 100%; background: var(--accent); border-radius: 3px 3px 0 0; opacity: .55; }
  .year:hover .bar { opacity: 1; }
  .year:hover .lbl { color: var(--ink); text-decoration: underline; }
</style>
